{
  "name": "dsh-sidebar",
  "description": "Right-docked modular Sidebar for DSH Web; initial cards provide VS Code-style Source Control and a Commit Graph, with a shared Card Manifest for future cards",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "auggie246",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auggie246/dsh-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/auggie246/dsh-sidebar/issues"
  },
  "homepage": "https://github.com/auggie246/dsh-sidebar#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sidebar",
    "git"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/",
    "dynamic/",
    "scripts/",
    "cordis.patch.example.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bundle:dynamic": "node scripts/bundle-dynamic.mjs",
    "prepare": "npm run bundle:dynamic",
    "test": "node --check lib/client.js && node --input-type=module --check < lib/index.js && node --input-type=module --check < lib/remote.js && node scripts/test-new-session-sidebar.mjs && node scripts/test-global-sidebar-state.mjs && node scripts/test-workspace-cwd-retention.mjs && node scripts/test-workspace-cwd-remount.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "react": "^18.2.0"
  }
}
